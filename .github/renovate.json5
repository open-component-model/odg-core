{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'config:best-practices',
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
    'security:openssf-scorecard',
    ':dependencyDashboard',
    ':rebaseStalePrs',
  ],
  internalChecksFilter: 'strict',
  minimumReleaseAge: '7 days',
  branchPrefix: 'renovate/',
  prConcurrentLimit: 5,
  prHourlyLimit: 0,
  automerge: false,
  automergeType: 'pr',
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
    automerge: false,
  },
  lockFileMaintenance: {
    automerge: true,
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Dockerfile$/',
      ],
      matchStrings: [
        'ARG CBOMKIT_THEIA_VERSION=(?<currentValue>[^\\n]+)\\nARG CBOMKIT_THEIA_COMMIT=(?<currentDigest>[^\\n]+)',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'cbomkit/cbomkit-theia',
      versioningTemplate: 'semver-coerced',
      extractVersionTemplate: '^v?(?<version>.*)$',
    },
  ],
  packageRules: [
    {
      matchDepNames: [
        'gardener-cicd-libs',
        'gardener-ocm',
        'gardener-oci',
      ],
      groupName: 'gardener python deps',
    },
    {
      matchPackageNames: [
        'opentelemetry-*',
      ],
      groupName: 'opentelemetry python deps',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
    },
    {
      matchUpdateTypes: [
        'patch',
        'digest',
        'pinDigest',
      ],
      automerge: true,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
    },
    {
      matchManagers: [
        'pep621',
        'uv',
      ],
      matchDepNames: [
        'bdba-client',
        'odg-client',
      ],
      enabled: false,
    },
  ],
}
