ARG ODG_CORE_LIBS_VERSION=latest

# Build stage: compile memray from source (cached)
FROM python:3.14-alpine3.24@sha256:f6a589d43c42b9e7f7dc67a12d37132491f362859a5d750607710cc56da3bc72 AS builder

RUN apk add --no-cache \
    elfutils-dev \
    g++ \
    gcc \
    libunwind-dev \
    lz4-dev \
    make \
    musl-dev

COPY --from=ghcr.io/astral-sh/uv:0.12.21@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711 /uv /usr/local/bin/

ENV VIRTUAL_ENV=/opt/build
RUN uv venv "$VIRTUAL_ENV" \
 && uv pip install --no-cache \
    "memray==1.20.0" \
    "py-spy==0.4.2"


# Final debug image: prod base + runtime libs + memray + py-spy
FROM odg-core:${ODG_CORE_LIBS_VERSION}
ARG ODG_CORE_LIBS_VERSION

# Runtime deps for memray (needed when compiled from source on arm64;
# on amd64 memray ships bundled libs but these are harmless to install)
RUN apk add --no-cache \
    elfutils \
    libunwind \
    lz4-libs

COPY --from=builder /opt/build/lib/python3.14/site-packages \
                    /opt/venv/lib/python3.14/site-packages
COPY --from=builder /opt/build/bin/py-spy /opt/venv/bin/py-spy
