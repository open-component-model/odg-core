ARG ODG_CORE_LIBS_VERSION=latest

# Build stage: compile memray from source (cached)
FROM python:3.14-alpine3.24@sha256:9e9fde4d32eedce0b661d9ab91e826b62dddf28e928c230ec55f1866cac66b01 AS memray-builder

RUN apk add --no-cache \
    elfutils-dev \
    g++ \
    gcc \
    libunwind-dev \
    lz4-dev \
    make \
    musl-dev

COPY --from=ghcr.io/astral-sh/uv:0.12.21@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711 /uv /usr/local/bin/

ENV VIRTUAL_ENV=/opt/memray-build
RUN uv venv "$VIRTUAL_ENV" \
 && uv pip install --no-cache \
    "memray>=1.20.0" \
    "py-spy>=0.4.2"


# Final debug image: prod base + runtime libs + pre-built wheels from builder
FROM odg-core:${ODG_CORE_LIBS_VERSION}
ARG ODG_CORE_LIBS_VERSION

# Runtime libs only (no compiler)
RUN apk add --no-cache \
    elfutils \
    libunwind \
    lz4-libs

COPY --from=memray-builder /opt/memray-build/lib /opt/venv/lib
COPY --from=memray-builder /opt/memray-build/bin/py-spy /opt/venv/bin/py-spy
