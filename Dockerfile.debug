ARG ODG_CORE_LIBS_VERSION=latest

# Build stage: compile memray from source (cached)
FROM registry.suse.com/bci/python:3.14@sha256:5ee77207d55d42d760ade2f24418dc01c216f2bfde0c5ce14977137d4f59dd2e AS builder

RUN zypper --non-interactive install --no-recommends \
    binutils \
    gcc \
    gcc-c++ \
    libunwind-devel \
    liblz4-devel \
    make \
 && zypper --non-interactive clean --all

# renovate: datasource=docker depName=docker.io/astral/uv
COPY --from=docker.io/astral/uv:0.13.10@sha256:a3ea1357342c1a4bf9a0c53a3deb1b55379aefa037338d8113d5771efa01774f /uv /usr/local/bin/

ENV VIRTUAL_ENV=/opt/build
RUN uv venv "$VIRTUAL_ENV" \
 && uv pip install --no-cache \
    "memray==1.20.0" \
    "py-spy==0.4.2"


# Final debug image: prod base + runtime libs + memray + py-spy
FROM odg-core:${ODG_CORE_LIBS_VERSION}
ARG ODG_CORE_LIBS_VERSION

COPY --from=builder /opt/build/lib/python3.14/site-packages \
                    /opt/venv/lib/python3.14/site-packages
COPY --from=builder /opt/build/bin/py-spy /opt/venv/bin/py-spy
